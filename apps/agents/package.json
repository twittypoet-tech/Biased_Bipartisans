{
  "name": "@bipi/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "download-files": "node -e \"console.log('No model files required')\"",
    "start": "node dist/workers/live-debate-worker.js start",
    "start:scheduler": "node dist/index.js",
    "worker:dev": "tsx src/workers/debate-worker.ts dev",
    "worker:start": "node dist/workers/debate-worker.js start",
    "worker:live:dev": "tsx src/workers/live-debate-worker.ts dev",
    "worker:live:start": "node dist/workers/live-debate-worker.js start",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured yet'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@bipi/agent-core": "workspace:*",
    "@bipi/db": "workspace:*",
    "@bipi/shared": "workspace:*",
    "@dicebear/bottts": "^9.4.2",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@livekit/agents": "^1.0.50",
    "@livekit/agents-plugin-deepgram": "^1.0.0",
    "@livekit/agents-plugin-elevenlabs": "^1.0.0",
    "@livekit/agents-plugin-livekit": "^1.0.0",
    "@livekit/agents-plugin-silero": "^1.0.0",
    "@livekit/rtc-node": "^0.13.24",
    "@supabase/supabase-js": "^2.45.0",
    "livekit-server-sdk": "^2.9.0",
    "openai": "^4.80.0",
    "retell-sdk": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.4",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
