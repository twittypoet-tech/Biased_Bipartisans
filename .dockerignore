# Git
.git
.gitignore

# Dependencies (reinstalled in Docker)
**/node_modules
**/.pnpm-store

# Build output (rebuilt in Docker)
**/dist
**/.next
**/out
**/.turbo
**/*.tsbuildinfo

# Environment files (injected at runtime via env_file or LiveKit secrets)
.env
.env.*
**/.env
**/.env.*

# Web app (not needed for the agent worker)
apps/web

# Jobs app (separate service)
apps/jobs

# Test coverage
**/coverage

# IDE / OS
.vscode
.idea
**/.DS_Store
**/Thumbs.db

# Logs
**/*.log
**/npm-debug.log*

# Docker files themselves
Dockerfile*
.dockerignore
docker-compose*.yml
