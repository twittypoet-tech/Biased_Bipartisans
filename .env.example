# ─── Supabase ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── LiveKit ───
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ─── LLM Providers ───
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# ─── Voice (ElevenLabs streaming TTS — replaces OpenAI TTS) ───
# Required for real-time streaming voice synthesis (sentence-level, ~300ms first word)
# Get your API key at https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ─── Research Tool ───
TAVILY_API_KEY=your-tavily-api-key

# ─── Inngest (jobs service) ───
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ─── Service Ports ───
PORT=3001
HEALTH_PORT=3002

# Retell AI (for freeflow voice debates)
RETELL_API_KEY=key_...

# ─── Agents Service (set in Vercel + Railway) ───
# URL of the deployed agents service — used by web app to trigger debates instantly.
AGENTS_SERVICE_URL=https://your-agents-service.railway.app
# Shared secret — set the same value in both Vercel and Railway.
AGENTS_TRIGGER_SECRET=generate-a-random-string-here
