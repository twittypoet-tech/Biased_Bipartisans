{
  "name": "bipi",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @bipi/web dev",
    "dev:agents": "pnpm --filter @bipi/agents dev",
    "dev:jobs": "pnpm --filter @bipi/jobs dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "setup": "pnpm install && echo '\\nSetup complete! Copy .env.example to .env and fill in your credentials.'",
    "avatars:generate": "pnpm --filter @bipi/agents tsx src/scripts/generate-agent-avatars.ts"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
